oGTPmlxZ/tb"],[4,4281872933],36],[21,45,-1000,100,160,-88,[0,"f0TVyCJXVGzb0zdibzuPy5"]]],[1,"99CbDaC/JB16E4tsqmEoZ5",null,null,null,1,0],[1,0,-500,0]],[5,"Header1",33554432,3,[[2,-89,[0,"de5TB7I7hJ07CmNNAg1mYD"],[5,990,120]],[7,"玩法介绍",0,60,60,1,false,true,-90,[0,"10wFi0hfJPcqgG8p6wVN7n"],[4,2533359615],37],[6,40,80,-91,[0,"86B4ejf6BKT6UmQFIJ3lsN"]]],[1,"afmyrVklpMu4apoIXmN6cM",null,null,null,1,0],[1,0,-60,0]],[5,"Page1",33554432,3,[[2,-92,[0,"75mHiCjO1Mh5wPCsVa+ziQ"],[5,990,120]],[8,"一款支持 2～6 人游玩的混乱竞速狂欢游戏！率先到达终点的玩家获胜！",0,45,45,60,1,false,-93,[0,"81VFZKvoVKuppFnDpprjH9"],[4,2533359615],38],[6,40,80,-94,[0,"c7CSDwwIpAxZ4kQDla9se3"]]],[1,"019kxmDXBAmaMe+zPFbeFQ",null,null,null,1,0],[1,0,-180,0]],[5,"Header2",33554432,3,[[2,-95,[0,"cfaOyDqgxAf4OOkL3ybzUq"],[5,990,120]],[7,"游戏目标",0,60,60,1,false,true,-96,[0,"4473T01k1Lr4SZSKxMHcl4"],[4,2533359615],39],[6,40,80,-97,[0,"2b5tYxmpRBeKgxalllzjNs"]]],[1,"a1N+9Jw7lBt5SklmuzQHpf",null,null,null,1,0],[1,0,-340,0]],[5,"Page2",33554432,3,[[2,-98,[0,"afACe2Y81Lzp8IowQJdfDS"],[5,990,660]],[8,"整场游戏共进行 4 轮。\n每轮开始时，每位玩家选择 1 名参赛者进行比赛。率先冲过终点线的前 2 名玩家将获得积分。4 轮比赛结束后，累计积分最高的玩家获胜。\n每轮比赛的积分如下：\n1. 第一轮：冠军获得 3 分，亚军获得 1 分。\n2. 第二轮：冠军获得 4 分，亚军获得 2 分。\n3. 第三轮：冠军获得 4 分，亚军获得 2 分。\n4. 第四轮：冠军获得 5 分，亚军获得 3 分。\n此外，部分赛道格子和特殊参赛者的能力也可以提供额外积分。",0,45,45,60,1,false,-99,[0,"a6oklDTR9DPp7OrAdvt1r0"],[4,2533359615],40],[6,40,80,-100,[0,"96yrO2D8lAhIcwCU/jNJ2Q"]]],[1,"a3/Vsz3o5LdLHH5GeCzEi7",null,null,null,1,0],[1,0,-730,0]],[5,"Header6",33554432,3,[[2,-101,[0,"1283dFEEZFQIYGYhkyUTXc"],[5,990,120]],[7,"设置流程",0,60,60,1,false,true,-102,[0,"60cDK00wJKw5uzJjDZ1mAS"],[4,2533359615],41],[6,40,80,-103,[0,"65gW6Q495G3oQr8h6N1rJd"]]],[1,"86OG4ga3tL6r8ukVYolafx",null,null,null,1,0],[1,0,-1160,0]],[5,"Page21",33554432,3,[[2,-104,[0,"98ejsnlrZKSqd/71OAeWGK"],[5,990,1020]],[8,"1. 洗混所有 36 名参赛者。\n2. 根据玩家人数，翻开对应数量的参赛者：\n    a. 2 人局：翻开 8 名参赛者\n    b. 3 人局：翻开 6 名参赛者\n    c. 4 人局：翻开 8 名参赛者\n    d. 5 人局：翻开 10 名参赛者\n    e. 6 人局：翻开 12 名参赛者\n3. 选择参赛者。\n    所有玩家按照蛇形顺序依次选择参赛者，即按\n    照 A、B、C、D、D、C、B、A 的顺序轮流选\n    择。\n4. 重复步骤 2～3，直至所有玩家拥有足额的参赛\n    者。2～3人局中，每次重复选择流程时，将先\n    手玩家顺延 1 位。4～6人局中，第二轮从首轮\n    末尾玩家开始倒序选择。\n    a. 2～3 人局：每位玩家最终拥有 8 名参赛者。\n    b. 4～6 人局：每位玩家最终拥有 4 名参赛者。",0,45,45,60,1,false,-105,[0,"41q0tPsotEZ6pl0+7/L/v8"],[4,2533359615],42],[6,40,80,-106,[0,"f7er2Q1bxKEqve5+nP7mi4"]]],[1,"912wffVBZAeaNe1oyo7eQR",null,null,null,1,0],[1,0,-1730,0]],[5,"Header3",33554432,3,[[2,-107,[0,"76WioB8HtHT7D9qW1x/eNv"],[5,990,120]],[7,"UI介绍",0,60,60,1,false,true,-108,[0,"2eGC2DrrpCPYpQb81d/RZl"],[4,2533359615],43],[6,40,80,-109,[0,"0bsVQ5ZpBHsKbvnb0JZ4pW"]]],[1,"9ar+98NohN04GK6BZJHPCV",null,null,null,1,0],[1,0,-2340,0]],[5,"rule1",33554432,3,[[2,-110,[0,"b7FDQi3CpHI7FGvpcJgUyP"],[5,600,1100]],[4,2,-111,[0,"4cgjp4Y3ROJbaAnTuiB2xo"],44],[22,8,-112,[0,"c5d3Ow3B1GApw1P53nMIl3"]]],[1,"0cq0m1MQdD5YbkF53TvViL",null,null,null,1,0],[1,-195,-2965,0]],[5,"Page4",33554432,3,[[2,-113,[0,"e4wOYn6TxOwJny3EXjlKBC"],[5,990,640]],[8,"1. 顶部：游戏信息\n    显示当前游戏状态及赛程等信息。\n2. 玩家信息区域\n    显示 2～6 名玩家的信息，包括本轮选择的参赛\n    者以及当前累计积分。\n3. 游戏版图\n    位于界面中央，占据最大的区域。所有参赛者\n    和赛道地图均显示在此区域。\n4. 操作区域\n    位于界面底部，用于显示当前可执行的操作。",0,45,45,60,1,false,-114,[0,"c932ipLdRCKa4jXRZLY+D1"],[4,2533359615],45],[6,40,80,-115,[0,"0a2gfb3BtN/ZfdNA3N6eQe"]]],[1,"b3Ag46Y2tBtaxzutxhBvxV",null,null,null,1,0],[1,0,-3835,0]],[5,"Header10",33554432,3,[[2,-116,[0,"9fgtFVVLhORrcFQsIP4uzz"],[5,990,120]],[7,"游戏流程",0,60,60,1,false,true,-117,[0,"a1SfJxd91Pn7XI+NQbzD3q"],[4,2533359615],46],[6,40,80,-118,[0,"f8tvqpU35JxaR0GjMteU8r"]]],[1,"5b+llXEMpKgbilGoIIHyhk",null,null,null,1,0],[1,0,-4235,0]],[5,"Page13",33554432,3,[[2,-119,[0,"e9v8l3jIVB+rIiQagWJpU7"],[5,990,1740]],[8,"1. 决定赛道\n    a. 第 1、3 轮使用温和赛道。\n    b. 第 2、4 轮使用狂野赛道。\n2. 狂野赛道包含更多特殊效果，例如奖励积分、\n    绊倒、前进或后退等。\n3. 决定先手玩家\n    a. 第 1 轮由 1 号玩家先手。\n    b. 后续轮次由上一轮率先被淘汰或地图最落后\n        的玩家先手。\n4. 选择参赛者\n    所有玩家同时选择 1～2 名本轮比赛的参赛者，\n    选择完成后同时亮出。若每人操纵2名角色，则\n    先选择的角色始终优先行动。\n5. 玩家依次行动\n    在 2～3 人局中，每位玩家操控 2 名参赛者。\n    每轮开始时，玩家可以自由选择本轮率先行动\n    的参赛者。\n    a. 绊倒状态：若参赛者处于绊倒状态，则解除\n        其绊倒状态，并跳过本次行动。\n    b. 正常状态：若参赛者处于正常状态，则投掷\n        1 个骰子，并根据骰子点数向前移动对应格\n        数。\n6. 结束本轮\n    当任意 2 名玩家冲过终点线时，本轮立即结\n    束。\n7. 结束游戏\n    4 轮比赛全部结束后，累计积分最高的玩家获\n    胜。若多名玩家积分相同，则这些玩家共享胜\n    利。",0,45,45,60,1,false,-120,[0,"5awq9j+D1DsK8rwPAyGT9p"],[4,2533359615],47],[6,40,80,-121,[0,"73W7AAsQ5AnpVijbFi/kiU"]]],[1,"01wOtc7wdLtYKIl/nGv/iO",null,null,null,1,0],[1,0,-5165,0]],[5,"Header11",33554432,3,[[2,-122,[0,"efQpYD/gtKvbUmg4JQsQe7"],[5,990,120]],[7,"额外说明",0,60,60,1,false,true,-123,[0,"4aePhrZ9JJBJqAExrUbygB"],[4,2533359615],48],[6,40,80,-124,[0,"1emacYDf5GyJD9VTTP/tuc"]]],[1,"cbQmKCxyJDYJzRCA+1kJM6",null,null,null,1,0],[1,0,-6115,0]],[5,"Page17",33554432,3,[[2,-125,[0,"aeRLW5ZgFFBK5vUs56rP+q"],[5,990,1680]],[8,"1. 超过：指参赛者移动前后分别位于某位参赛者\n    的两侧\n2. 重新投掷：若参赛者进行重新投掷，则重新投\n    掷前的骰子点数视为从未发生过，不会触发与\n    该点数相关的效果。\n3. 移动 0 格：移动 0 格不视为移动，不会触发与\n    移动相关的效果。\n4. 同时移动：同时移动的所有角色，不会互相触\n    发对方停留在xx地盘的能力\n5. 能力失效：玩家被淘汰或其参赛者到达终点\n    后，该参赛者的能力立即失效。\n7. 绊倒：处于绊倒状态的参赛者需要消耗一次行\n    动来恢复状态，但是其相关技能还是可以正常\n    触发的。\n7. 传送：不算作移动，但是可以触发“停留”的效\n    果\n8. 效果按照以下顺序结算：\n    a. 当前地图格的效果\n    b. 当前行动的参赛者效果\n    c. 其他参赛者的效果（行动顺序依次结算）\n9. 效果循环保护:\n    a. 在一系列效果连续触发的过程中，若某个效\n        果再次触发时，当前地图上的参赛者分布与\n        该效果上一次触发时完全一致，则该效果本\n        次不执行。\n    b. 在一系列效果连续触发的过程中，相同效果\n        来源不能重复触发 蹭蹭狗、恋爱脑、吸盘鱼\n        这三位角色的技能。",0,45,45,60,1,false,-126,[0,"15dHSLTqVF1L6AYZ9eKyfC"],[4,2533359615],49],[6,40,80,-127,[0,"3aHgifV4dPf7/t7w12CGEY"]]],[1,"43NgdLFWJDMIU4oqJnptmb",null,null,null,1,0],[1,0,-7015,0]],[5,"Header12",33554432,3,[[2,-128,[0,"1bj97wGU9FlbpACCYhQNM8"],[5,990,120]],[7,"角色介绍",0,60,60,1,false,true,-129,[0,"76pQyav5VG8I/bOG3boIFj"],[4,2533359615],50],[6,40,80,-130,[0,"86S84RZPdL3aMaSf5kWarr"]]],[1,"c3feA/bX1EcqnrX/G2VucF",null,null,null,1,0],[1,0,-7935,0]],[35,["92I8YinW1Mg4kvmXn689YP"]],[3,"乐子人",33554432,2,[[2,-131,[0,"17KJg/LZlGM7Gtw0DAKjGH"],[5,177,241]],[4,0,-132,[0,"69fuRNrnlIrpQ17Xm45ntA"],0]],[1,"daQMnqfTJN+KjyNZkDs7TJ",null,null,null,1,0]],[3,"死脑筋",33554